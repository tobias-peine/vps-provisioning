# Verwaltet von Ansible (Rolle fail2ban) - manuelle Aenderungen werden ueberschrieben.
# backend = systemd: der Filter liest das Journal statt einer Logdatei. Damit
# funktioniert der Jail unabhaengig davon, ob sshd in eine Datei schreibt.
[DEFAULT]
ignoreip = {{ fail2ban_ignoreip }}
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}

[sshd]
enabled = true
port    = {{ ssh_port }}
backend = systemd
# Ubuntu startet sshd als ssh.service; "sshd.service" ist nur ein systemd-Alias
# und steht so nicht im Journal. Ohne diese Zeile matcht der Debian-Default
# (_SYSTEMD_UNIT=sshd.service) nichts: der Jail zaehlt dann 0 Fehlversuche und
# sperrt nie. Nachgeprueft am 13.11.2026: 790 Journal-Zeilen in 24 h auf
# ssh.service, 1 auf sshd.service.
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd
