#!/usr/bin/env bash
# Verwaltet von Ansible (Rolle stack_metrics).
# Sichert die auf dem Monitoring-Host erzeugten Zugangsdaten
# (Grafana-Adminpasswort, ntfy-Thema) auf den App-Host. Von dort nimmt sie der
# naechtliche Restic-Job mit; ohne diesen Schritt waeren sie bei einem Verlust
# der Maschine weg und alle ntfy-Abos muessten neu eingerichtet werden.
#
# Voraussetzung (einmalig, nicht von Ansible verwaltet): der Key
# /root/.ssh/id_ed25519_backup dieses Hosts liegt in authorized_keys von
# admin@<App-Host>. Port 2222, weil dort sshd nicht auf 22 lauscht.
set -euo pipefail
DEST="admin@{{ metrics_app_host }}:/home/admin/monitor-secrets/"
rsync -a --chmod=F600 \
  -e "ssh -p 2222 -i /root/.ssh/id_ed25519_backup -o BatchMode=yes -o StrictHostKeyChecking=accept-new" \
  {{ metrics_dir }}/grafana.env {{ metrics_dir }}/alertbridge.env "$DEST"
