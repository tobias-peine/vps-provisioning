---
# Verwaltet von Ansible (Rolle stack_metrics).
# Phase 1 der Observability: nur sammeln. Dashboards (Grafana) und Alarme
# (Alertmanager) folgen in Phase 2 und 3 - ein Schritt pro Ausbau, damit man
# jeden einzeln versteht und einzeln zurueckrollen kann.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

# Alarmregeln liegen im Repo und werden mit den Targets zusammen versioniert.
rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  # Prometheus selbst: zeigt, ob der Scrape-Zyklus und die eigene
  # Speichernutzung gesund sind.
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090
        labels:
          host: monitor

  # Host-Metriken: CPU, RAM, Swap, Disk, Netzwerk, Load.
  - job_name: node
    static_configs:
      - targets:
          - node-exporter:9100
        labels:
          host: monitor

  # Container-Metriken: CPU und RAM je Container, Restarts, Image-Groessen.
  - job_name: cadvisor
    static_configs:
      - targets:
          - cadvisor:8080
        labels:
          host: monitor

{% if metrics_remote_host | default('') | length > 0 %}
  # Zweite Maschine ueber Tailscale. Auf dem App-Host laufen dann nur noch die
  # Exporter, waehrend Prometheus hier liegt - faellt der App-Host aus, laeuft
  # die Ueberwachung weiter und kann es melden.
  - job_name: remote-node
    static_configs:
      - targets:
          - "{{ metrics_remote_host }}:9100"
        labels:
          host: app

  - job_name: remote-cadvisor
    static_configs:
      - targets:
          - "{{ metrics_remote_host }}:8080"
        labels:
          host: app
{% endif %}
