---
# Verwaltet von Ansible (Rolle stack_metrics).
# Die Sammler (node-exporter, cAdvisor) laufen ueber die Rolle metrics_exporters
# auf jedem Host; hier werden sie nur abgefragt.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

# Alarmregeln liegen im Repo und werden mit den Targets zusammen versioniert.
rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  # Prometheus selbst: zeigt, ob der Scrape-Zyklus und die eigene
  # Speichernutzung gesund sind.
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090
        labels:
          host: monitor

  # Beide Hosts werden ueber ihre Tailscale-Adresse abgefragt. Das ist
  # gleichzeitig die Trennung: faellt der App-Host aus, laeuft die Ueberwachung
  # hier weiter und der Ausfall ist als "down" sichtbar.
  - job_name: node-monitor
    static_configs:
      - targets:
          - "{{ metrics_monitor_host }}:9100"
        labels:
          host: monitor

  - job_name: cadvisor-monitor
    static_configs:
      - targets:
          - "{{ metrics_monitor_host }}:8080"
        labels:
          host: monitor

  - job_name: node-app
    static_configs:
      - targets:
          - "{{ metrics_app_host }}:9100"
        labels:
          host: app

  - job_name: cadvisor-app
    static_configs:
      - targets:
          - "{{ metrics_app_host }}:8080"
        labels:
          host: app
