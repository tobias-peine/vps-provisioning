---
# Verwaltet von Ansible (Rolle stack_metrics).
#
# Zwei Wege, absichtlich parallel:
#   1. Home Assistant (Webhook) - der gewohnte Kanal, landet bei der Familie.
#   2. ntfy ueber alertbridge - unabhaengig von HA. Faellt der App-Host aus,
#      kann HA nichts mehr melden; ntfy laeuft ueber das Internet und kommt an.
# Der Alertmanager selbst laeuft auf dem Monitoring-Host und ueberlebt den
# Ausfall des App-Hosts.
global:
  resolve_timeout: 5m

route:
  receiver: alerts
  # Nach Alarmname gruppieren: ein voller Swap erzeugt sonst eine Nachricht pro
  # betroffenem Container.
  group_by:
    - alertname
  group_wait: 30s
  group_interval: 5m
  # Nach 12 h erneut erinnern, solange der Alarm noch aktiv ist.
  repeat_interval: 12h

receivers:
  - name: alerts
    webhook_configs:
      - url: "http://{{ metrics_ha_host }}:8123/api/webhook/{{ metrics_ha_webhook_id }}"
        send_resolved: true
        max_alerts: 5
      - url: "http://alertbridge:8080/alert"
        send_resolved: true
        max_alerts: 5
{% if metrics_alert_mail | bool %}
    # Dritter Weg: direkt per SMTP raus. Unabhaengig von Home Assistant und
    # von ntfy - falls ein Kanal mal haengt, bleibt dieser.
    email_configs:
      - to: "{{ metrics_alert_mail_to }}"
        from: "{{ metrics_alert_mail_from }}"
        smarthost: "{{ metrics_alert_mail_smarthost }}"
        auth_username: "{{ vault_mail_user }}"
        auth_password: "{{ vault_mail_password }}"
        require_tls: true
        send_resolved: true
{% endif %}
