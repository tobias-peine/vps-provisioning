@@ -111,6 +111,71 @@
 <script src="{{asset "built/casper.js"}}" defer></script>
 
 {{!-- Ghost outputs required functional scripts with this tag - it should always be the last thing before the closing body tag --}}
+    {{!-- Portal is excluded from ghost_head and loaded on demand to cut initial JS --}}
+    <script>
+    (function () {
+        var portalUrl = 'https://cdn.jsdelivr.net/ghost/portal@~2.72/umd/portal.min.js';
+        var loading = false;
+        var ready = false;
+        var pending = null;
+
+        function loadPortal() {
+            if (ready || loading) return;
+            loading = true;
+            var search = document.querySelector('script[data-sodo-search]');
+            var key = search ? search.getAttribute('data-key') : '';
+            var script = document.createElement('script');
+            script.src = portalUrl;
+            script.async = true;
+            script.crossOrigin = 'anonymous';
+            script.setAttribute('data-i18n', 'true');
+            script.setAttribute('data-ghost', location.origin);
+            if (key) script.setAttribute('data-key', key);
+            script.setAttribute('data-api', location.origin + '/ghost/api/content');
+            script.setAttribute('data-locale', (search && search.getAttribute('data-locale')) || 'en');
+            script.onload = function () {
+                ready = true;
+                loading = false;
+                if (pending) {
+                    var el = pending;
+                    pending = null;
+                    var target = el.getAttribute('href') || ('#/portal/' + (el.getAttribute('data-portal') || 'signin'));
+                    if (target.indexOf('#/portal') === 0) {
+                        location.hash = target;
+                    } else {
+                        el.click();
+                    }
+                }
+            };
+            script.onerror = function () {
+                loading = false;
+            };
+            document.head.appendChild(script);
+        }
+
+        document.addEventListener('click', function (event) {
+            var target = event.target;
+            var link = target && target.closest ? target.closest('[data-portal]') : null;
+            if (!link || ready) return;
+            event.preventDefault();
+            event.stopPropagation();
+            pending = link;
+            loadPortal();
+        }, true);
+
+        function openFromUrl() {
+            if (location.hash.indexOf('#/portal') === 0 || /[?&]portal=/.test(location.search)) {
+                loadPortal();
+            }
+        }
+        if (document.readyState === 'loading') {
+            document.addEventListener('DOMContentLoaded', openFromUrl);
+        } else {
+            openFromUrl();
+        }
+    })();
+    </script>
+
 {{ghost_foot}}
 
 </body>
